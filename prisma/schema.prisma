generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Player {
  login         String   @id
  points        Int      @default(0)
  wins          Int      @default(0)
  losses        Int      @default(0)
  ties          Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  wonBattles    Battle[] @relation("Winner")
  lostBattles   Battle[] @relation("Loser")
}

model Battle {
  id           String   @id
  winnerLogin  String?
  loserLogin   String?
  isTie        Boolean  @default(false)
  points       Int      @default(0)
  createdAt    DateTime @default(now())

  winner Player? @relation("Winner", fields: [winnerLogin], references: [login])
  loser  Player? @relation("Loser", fields: [loserLogin], references: [login])

  @@index([createdAt])
}
